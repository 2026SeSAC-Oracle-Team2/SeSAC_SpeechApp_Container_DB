# Oracle SYS/SYSTEM 비밀번호
ORACLE_PASSWORD=ChangeMe123

# 애플리케이션 DB 계정 비밀번호
APP_USER_PASSWORD=AppPass123

# 관리자 DB 계정 비밀번호
ADMIN_USER_PASSWORD=AdminPass123
